# Secrets and private data. NEVER commit.
# (Root-anchored: the committed template at templates/candidate_facts.yaml
#  must NOT be ignored, so the working files below use a leading slash.)
.env
.env.*
!.env.example
/candidate_facts.yaml
/resumes/
*.pdf
*.docx
# Test fixtures are regenerated by tests/make_fixtures.py but tests need them
# in a fresh clone, so they are force-included.
!tests/fixtures/*.pdf
!tests/fixtures/*.docx

# Local runtime data
.browser/
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
Thumbs.db
Desktop.ini
.DS_Store