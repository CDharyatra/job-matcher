# =============================================================================
# .env.example  —  copy to ".env" and fill in. ".env" is gitignored.
# NEVER paste these values into a hosted model or into docs/logs.
# =============================================================================

# --- NVIDIA free trial endpoints (OpenAI-compatible) --------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenCode Zen (optional; FREE model ids only) -----------------------------
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- Backup judges (optional, $0 free tiers) ----------------------------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Mistral Studio free mode (no card): console.mistral.ai -> API Keys.
MISTRAL_API_KEY=

# --- Rerank scoring (optional, $0 free tiers; fail soft when absent) ----------
# Jina: free key, ~10M tokens, 100 RPM (primary rerank). https://jina.ai/
JINA_API_KEY=
# Voyage (MongoDB): 200M tokens free one-time. https://docs.voyageai.com/
VOYAGE_API_KEY=
# Cohere trial: ~1,000 calls/month. Audit reserve only. https://cohere.com/
COHERE_API_KEY=
# local_bge needs no key: pip install torch --index-url
# https://download.pytorch.org/whl/cpu transformers sentence-transformers
# Optional: a free Hugging Face token silences the "unauthenticated requests"
# warning and raises download rate limits. Never needed for scoring itself.
# HF_TOKEN=

# --- Gmail (personal @gmail.com). Requires 2-Step Verification + app password -
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail label/folder for job-alert mail. Only used when
# email.alert_intake_enabled is true in config.yaml (off by default).
JOB_ALERTS_FOLDER=jobs

# --- Local paths --------------------------------------------------------------
# Fill resume paths in candidate_facts.yaml; this is just the root folder.
RESUME_DIR=./resumes
